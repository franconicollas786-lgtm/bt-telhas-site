# Nenhuma variável de ambiente é obrigatória para rodar o site localmente.
#
# Opcional — desativa hot module replacement no servidor de desenvolvimento:
# DISABLE_HMR=true

# URL do painel admin (API de catálogo). Precisa estar setada ANTES do build
# (Vite lê env em build-time) — sem ela, o site usa o painel de produção como padrão.
# VITE_API_URL=https://bttelhas-admin.axismarketing.app
