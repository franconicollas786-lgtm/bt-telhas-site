# Apache (HostGator): envia rotas do SPA para index.html. Ajuste RewriteBase se o site
# estiver em subpasta (ex.: /loja/ → RewriteBase /loja/)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Força www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Open Graph — nunca redirecionar para index.html
  RewriteRule ^og-image\.(jpe?g|png|webp)$ - [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
</IfModule>
